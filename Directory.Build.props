<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <AudioBuleRepoRoot>$(MSBuildThisFileDirectory)</AudioBuleRepoRoot>
    <!-- 使用 NuGet 实际还原目录，兼容本机自定义磁盘与 GitHub 托管运行器。 -->
    <RestorePackagesPath Condition="'$(NUGET_PACKAGES)' != ''">$(NUGET_PACKAGES)</RestorePackagesPath>
    <AudioBuleNuGetRoot Condition="'$(RestorePackagesPath)' != ''">$(RestorePackagesPath)</AudioBuleNuGetRoot>
    <AudioBuleNuGetRoot Condition="'$(AudioBuleNuGetRoot)' == ''">$(UserProfile)\.nuget\packages</AudioBuleNuGetRoot>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <!-- 按安装的 VS 选择工具集，也允许命令行显式覆盖。 -->
    <PlatformToolset Condition="'$(PlatformToolset)' == '' and '$(VisualStudioVersion)' &gt;= '18.0'">v145</PlatformToolset>
    <PlatformToolset Condition="'$(PlatformToolset)' == ''">v143</PlatformToolset>
    <GoogleTestRoot>$(AudioBuleRepoRoot)third_party\googletest\</GoogleTestRoot>
    <WilIncludePath>$(AudioBuleNuGetRoot)\microsoft.windows.implementationlibrary\1.0.260126.7\include</WilIncludePath>
  </PropertyGroup>
</Project>
