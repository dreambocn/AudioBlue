# MSBuild intermediate output and build results.
# Every path is anchored with a leading '/' on purpose -- a bare "bin/" would
# also swallow tools/volume-spike/bin/, which is deliberately kept.
/x64/
/Debug/
/Release/
/AudioBule.Core/bin/
/AudioBule.Core/obj/
/AudioBule.App/bin/
/AudioBule.App/obj/
/tests/bin/
/tests/obj/
/.vs/
*.user
*.aps
*.tlog
*.idb
*.ipch
*.iobj

# XAML compiler output
/AudioBule.App/Generated Files/

# 本地诊断日志与临时编译产物。
/.superpowers/*.log
/.superpowers/*.xml
/.superpowers/*.exe
/.superpowers/*.obj

# Icon build intermediates. The .ico files themselves ARE committed because
# both the app and the test project embed them as RCDATA resources.
/assets/icons/generated/

# Packaging output
AppPackages/
*.msix
*.msixbundle
*.appx
*.appxbundle
*.pri

# Signing certificates contain a private key -- never commit
*.pfx
