# MSBuild intermediate output and build results.
# Every path is anchored with a leading '/' on purpose -- a bare "bin/" would
# also swallow tools/volume-spike/bin/, which is deliberately kept.
/x64/
/Debug/
/Release/
/ARM64/
/artifacts/
/.nuget/
/AudioBule.Core/bin/
/AudioBule.Core/obj/
/AudioBule.App/bin/
/AudioBule.App/bin-review/
/AudioBule.App/bin-aligned/
/AudioBule.App/obj/
/tests/bin/
/tests/obj/
/.vs/
*.user
*.aps
*.tlog
*.idb
*.ipch
*.iobj

# XAML compiler output
/AudioBule.App/Generated Files/

# 本地诊断日志与临时编译产物。
/.superpowers/*.log
/.superpowers/*.xml
/.superpowers/*.exe
/.superpowers/*.obj

# Icon build intermediates. The .ico files themselves ARE committed because
# both the app and the test project embed them as RCDATA resources.
/assets/icons/generated/

# Packaging output
AppPackages/
*.msix
*.msixbundle
*.appx
*.appxbundle
*.pri

# Signing certificates contain a private key -- never commit
*.pfx

# 本机验证日志、结果数据和重复截图保留在本地，只提交代表性效果图。
/docs/native-ui/verification/
/docs/native-ui/screenshots/*.png
!/docs/native-ui/screenshots/alignment-devices-settings-dark-zh.png
!/docs/native-ui/screenshots/alignment-devices-english-dark.png
!/docs/native-ui/screenshots/alignment-devices-devices-english-dark.png
!/docs/native-ui/screenshots/alignment-devices-tray-dark.png
!/docs/native-ui/screenshots/alignment-devices-menu.png
/docs/ui-preview/verification*.json
/docs/ui-preview/preview-*.png
!/docs/ui-preview/preview-en-dark.png
!/docs/ui-preview/preview-icons-dark.png
