<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{A1B2C3D4-0003-4E5F-9A8B-000000000003}</ProjectGuid>
    <RootNamespace>AudioBuleCoreTests</RootNamespace>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="Shared" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)'=='Debug'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)'=='Release'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <TargetName>AudioBule.Core.Tests</TargetName>
    <IntDir Condition="'$(AudioBuleBuildRoot)' == ''">$(ProjectDir)obj\</IntDir>
    <IntDir Condition="'$(AudioBuleBuildRoot)' != ''">$(AudioBuleBuildRoot)$(Platform)\$(Configuration)\$(MSBuildProjectName)\obj\</IntDir>
    <OutDir Condition="'$(AudioBuleBuildRoot)' == ''">$(ProjectDir)bin\</OutDir>
    <OutDir Condition="'$(AudioBuleBuildRoot)' != ''">$(AudioBuleBuildRoot)$(Platform)\$(Configuration)\$(MSBuildProjectName)\bin\</OutDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\cppwinrt\winrt;$(WilIncludePath);$(ProjectDir);$(ProjectDir)..\AudioBule.Core;$(GoogleTestRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <TreatWarningAsError>true</TreatWarningAsError>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <!-- Core is /MT (static CRT). Must be set under ClCompile, NOT Link.
           Setting /MD here conflicts with Core's /MT and the linker reports LNK2038. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <!-- The CRT must match Core's for the current configuration. Debug uses
       MultiThreadedDebug, Release uses MultiThreaded; a mismatch (or leaving
       one configuration at the /MD default) yields LNK2038. -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </ClCompile>
    <Link>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="main.cpp" />
    <ClCompile Include="SimpleEvent.test.cpp" />
    <ClCompile Include="StringUtil.test.cpp" />
    <ClCompile Include="Settings.test.cpp" />
    <ClCompile Include="ConnectionManager.test.cpp" />
    <ClCompile Include="IconFactory.test.cpp" />
    <ClCompile Include="AudioSessionIdentity.test.cpp" />
  </ItemGroup>
  <ItemGroup>
    <!-- GoogleTest 1.17.0 vendored under third_party/. The NuGet package
         (googletest 1.8.3) does NOT compile under v145: it uses std::tr1::tuple,
         which was removed, failing with C3083: "tr1".
         gtest_main.cc is intentionally NOT compiled: main.cpp below defines our
         own entry point that initializes the WinRT apartment, which Core's
         PathIO/JsonObject calls require. -->
    <ClCompile Include="$(GoogleTestRoot)src\gtest-all.cc">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <AdditionalIncludeDirectories>$(GoogleTestRoot);$(GoogleTestRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- GoogleTest's own headers trigger C4251 (undll-interface std::string)
           and similar DLL-boundary warnings. Those are not defects in our code. -->
      <TreatWarningAsError>false</TreatWarningAsError>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <!-- 资源不会经由静态库传递到 exe，必须由最终链接的可执行工程自己编译一次。
         与 AudioBule.App 里的同一份。 -->
    <ResourceCompile Include="..\AudioBule.Core\IconFactory.rc" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AudioBule.Core\AudioBule.Core.vcxproj">
      <Project>{A1B2C3D4-0001-4E5F-9A8B-000000000001}</Project>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.ImplementationLibrary" Version="1.0.260126.7" />
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="3.0.260520.1" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
