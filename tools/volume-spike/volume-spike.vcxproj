  <PropertyGroup>
    <TargetName>volume-spike</TargetName>
    <IntDir>$(ProjectDir)obj\</IntDir>
    <OutDir>$(ProjectDir)bin\</OutDir>
    <!--
      Windows SDK 自带 C++/WinRT 投影头，位于 <sdk>\Include\<ver>\cppwinrt\winrt\。
      MSBuild 默认注入的是 <sdk>\Include\<ver>\winrt\（那是 C 语言头，不是投影头），
      因此必须显式补上 cppwinrt\winrt，否则 #include <winrt/base.h> 找不到。
    -->
    <CppWinRTProjectionIncludePath>$(WindowsSdkDir)\Include\$(WindowsSDKVersion)\cppwinrt\winrt</CppWinRTProjectionIncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(CppWinRTProjectionIncludePath);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <TreatWarningAsError>true</TreatWarningAsError>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <!-- C++/WinRT 生成的投影头是 UTF-8 无 BOM，本机系统代码页为 936(GBK)，
           不加 /utf-8 会触发 C4819，而 /WX 会把它升级为错误 -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(CppWinRTProjectionIncludePath);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <TreatWarningAsError>true</TreatWarningAsError>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <!-- C++/WinRT 生成的投影头是 UTF-8 无 BOM，本机系统代码页为 936(GBK)，
           不加 /utf-8 会触发 C4819，而 /WX 会把它升级为错误 -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
