<Window x:Class="AudioBule.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 原生导航和主题资源保持与 Windows 控件一致。 -->
    <Grid x:Name="RootPanel">
        <Grid.Resources>
            <!-- 保留单选控件的键盘和选择语义，仅将外观收敛为文字页签。 -->
            <Style x:Key="DeviceFilterTabStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="MinHeight" Value="40"/>
                <Setter Property="Padding" Value="0,8,0,10"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
                <Setter Property="UseSystemFocusVisuals" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid x:Name="TabRoot" Background="Transparent" CornerRadius="4">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal"/>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters><Setter Target="TabRoot.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}"/></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters><Setter Target="TabRoot.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}"/></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters><Setter Target="TabRoot.Opacity" Value="0.4"/></VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="CheckStates">
                                        <VisualState x:Name="Unchecked"/>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters>
                                                <Setter Target="TabContent.Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
                                                <Setter Target="TabContent.FontWeight" Value="SemiBold"/>
                                                <Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Indeterminate"/>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="TabContent" Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                                    Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Rectangle x:Name="SelectionIndicator" Width="20" Height="3" RadiusX="1.5" RadiusY="1.5"
                                    Fill="{ThemeResource SystemAccentColor}" HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button x:Name="NavigationButton" Width="40" Height="32" Background="Transparent" BorderThickness="0" HorizontalAlignment="Center"><FontIcon Glyph="&#xE700;" FontSize="16"/></Button>
            <Grid x:Name="TitleDragRegion" Grid.Column="1" Margin="0,0,140,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/AppIcon.png" Width="20" Height="20"/>
                    <TextBlock Text="AudioBule" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
            IsPaneToggleButtonVisible="False" IsPaneOpen="True" OpenPaneLength="208" CompactPaneLength="48" PaneDisplayMode="Auto"
            ExpandedModeThresholdWidth="800" CompactModeThresholdWidth="480" IsTitleBarAutoPaddingEnabled="False">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DevicesNav" Tag="devices"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8EA;"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="AboutNav" Tag="about"><NavigationViewItem.Icon><FontIcon Glyph="&#xE946;"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="SettingsNav" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8,0,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0" Padding="28,24">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <InfoBar x:Name="StatusBar" Severity="Error" IsOpen="False" Margin="0,0,0,16"/>
                <Grid Grid.Row="1">
                    <Grid x:Name="DevicesPage" RowSpacing="24">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="4"><TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
                            <Button x:Name="AddDeviceButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center" Padding="12,5"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <RadioButton x:Name="AllFilter" GroupName="DeviceFilter" AutomationProperties.AutomationId="AllFilter" Style="{StaticResource DeviceFilterTabStyle}"/>
                                <RadioButton x:Name="ConnectedFilter" GroupName="DeviceFilter" AutomationProperties.AutomationId="ConnectedFilter" Style="{StaticResource DeviceFilterTabStyle}"/>
                            </StackPanel>
                            <Button x:Name="RefreshButton" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="16"/><TextBlock x:Name="RefreshLabel"/></StackPanel></Button>
                        </Grid>
                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="DeviceRows" Spacing="8"/></ScrollViewer>
                            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="320">
                                <FontIcon Glyph="&#xE702;" FontSize="32" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="EmptyTitle" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock x:Name="EmptyDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                                <Button x:Name="EmptyAction" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SettingsRows" Spacing="4"/></ScrollViewer>
                    <ScrollViewer x:Name="AboutPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AboutRows" Spacing="8"/></ScrollViewer>
                </Grid>
                <TextBlock x:Name="SummaryText" Grid.Row="2" Margin="0,20,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
