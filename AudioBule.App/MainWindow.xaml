<Window x:Class="AudioBule.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 固定操作区、可滚动设备列表和底部状态区。 -->
    <Grid x:Name="RootPanel" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <TextBlock Text="AudioBule" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="让电脑接收来自手机的蓝牙音频" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" Text="正在查找设备…" VerticalAlignment="Center" />
            <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" AutomationProperties.Name="刷新设备列表" />
            <Button x:Name="AddDeviceButton" Grid.Column="2" Content="添加设备" AutomationProperties.Name="打开系统蓝牙设置" />
        </Grid>
        <Grid Grid.Row="2">
            <ListView x:Name="DeviceList" SelectionMode="None" HorizontalContentAlignment="Stretch" />
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" MaxWidth="330">
                <FontIcon Glyph="&#xE702;" FontSize="36" HorizontalAlignment="Center" />
                <TextBlock Text="还没有可连接的设备" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="先在系统蓝牙设置中配对手机，再点击刷新。连接后，在手机上播放音频即可。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" Text="关闭窗口后继续在托盘运行" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <Button x:Name="ExitButton" Grid.Column="1" Content="退出" />
        </Grid>
    </Grid>
</Window>
